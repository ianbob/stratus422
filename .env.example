# Supabase public values are embedded in the browser bundle at build time.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Required only by server-side admin operations. Store as a Cloudflare secret.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Use your Paystack test secret key for development. Keep this server-side; never prefix it with VITE_.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_secret_key

# This key is safe to expose in the browser. Use your Paystack test public key.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_public_key